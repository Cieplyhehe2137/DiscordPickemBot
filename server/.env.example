DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
SESSION_SECRET=

# Origin of the web/ frontend (used for CORS + Socket.io). Must match the
# real production domain, not localhost, once deployed.
WEB_ORIGIN=

# Set to "production" on a real deployment - enables secure session cookies
# and disables the /api/auth/dev-login backdoor.
NODE_ENV=

# Optional, defaults to 3301 if unset.
PORT=

GUILD_CONFIG_DIR=
PICK_REMINDER_WINDOW_MINUTES=
PICK_REMINDER_COOLDOWN_HOURS=
PICK_REMINDER_MAX_USERS_PER_RUN=
CS_LIVE_MATCH_ID=
CS_LOG_PORT=
