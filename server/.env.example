DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Discord Developer
# Portal (OAuth2 -> Redirects) for this application, e.g.
# https://pickem.twojadomena.pl/api/auth/discord/callback
DISCORD_REDIRECT_URI=
SESSION_SECRET=

# Origin of the web/ frontend (used for CORS + Socket.io). In production,
# server/index.js serves the built web/dist itself (see the IS_PRODUCTION
# block near the bottom of the file), so API and frontend share one origin -
# set this to that same production domain, e.g. https://pickem.twojadomena.pl
# (not localhost). Only matters as a *different* origin if web/ is ever
# hosted separately from server/.
WEB_ORIGIN=

# Set to "production" on a real deployment - enables secure session cookies
# and disables the /api/auth/dev-login backdoor.
NODE_ENV=

# Optional, defaults to 3301 if unset.
PORT=

# Automatyczne propozycje wyników meczów. Puste = funkcja wyłączona i nic nie
# odpytuje zewnętrznego API. Jedyna obsługiwana dziś wartość: pandascore
# (CS2 siedzi u nich pod prefiksem /csgo/ - nazwa historyczna, nie literówka).
# Wyniki NIGDY nie zapisują się same: pobrane mecze trafiają do kolejki
# propozycji, którą admin zatwierdza w panelu.
RESULT_PROVIDER=
PANDASCORE_TOKEN=

# Tylko dla RESULT_PROVIDER=stub - ścieżka do pliku JSON z wynikami. Pozwala
# przećwiczyć cały przepływ (synchronizacja -> kolejka -> zatwierdzenie) i
# zobaczyć, jak zachowa się dopasowywanie nazw drużyn, zanim wykupisz dostęp
# do prawdziwego API. Format: [{"teamA":"...","teamB":"...","scoreA":2,"scoreB":1}]
RESULT_PROVIDER_FIXTURE=

# Katalog z config/*.env poszczególnych gildii. UWAGA: ścieżka względna jest
# rozwijana względem KATALOGU ROBOCZEGO procesu, nie położenia tego pliku.
# Lokalnie proces startuje z server/, więc działa "../config". Pod Passengerem
# (Plesk) katalogiem roboczym jest Application Root, więc tam wpisz ścieżkę
# BEZWZGLĘDNĄ, np. /var/www/vhosts/twojadomena.pl/pickem/config
# Bez tego serwer nie znajdzie danych dostępowych gildii i wywali się na
# pierwszym żądaniu dotyczącym konkretnego serwera Discord.
GUILD_CONFIG_DIR=
PICK_REMINDER_WINDOW_MINUTES=
PICK_REMINDER_COOLDOWN_HOURS=
PICK_REMINDER_MAX_USERS_PER_RUN=
CS_LIVE_MATCH_ID=
CS_LOG_PORT=
