# Wartości wspólne dla WSZYSTKICH serwerów Discorda.
#
# Ten plik NIE jest configiem gildii - nie może zawierać GUILD_ID i nie
# pojawia się na liście serwerów. Trafia tu wszystko, co i tak było
# identyczne w każdym config/<slug>.env: dane bazy, token bota, client id.
#
# Plik gildii nadpisuje dowolny klucz stąd, więc pojedynczy serwer może
# mieć np. własną bazę. Pusta wartość w pliku gildii nie kasuje wspólnej -
# jest traktowana jak brak.
#
# Bez tego pliku wszystko działa jak wcześniej: każdy config/<slug>.env
# musi być samowystarczalny.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Jedna aplikacja bota obecna na wielu serwerach - token i client id
# są wspólne. Osobne aplikacje per serwer wymagałyby osobnych procesów.
DISCORD_TOKEN=
CLIENT_ID=
