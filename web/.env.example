# Adres API, gdy front stoi na osobnym hoście (np. Cloudflare Pages).
#
# ZOSTAW PUSTE przy wdrożeniu jednoprocesowym, w którym Express serwuje
# web/dist pod tym samym adresem co /api. Wtedy front używa ścieżki względnej,
# ciasteczko sesji jest same-site i nie potrzeba CORS - tak jest dziś i tak
# jest prościej.
#
# Wypełnij tylko dla frontu na osobnym hoście. Wymagania po stronie backendu:
#   - publiczny adres po HTTPS (bez tego ciasteczko Secure nie przejdzie)
#   - ten origin Pages dopisany do WEB_ORIGIN w server/.env
#   - CROSS_ORIGIN_WEB=1 w server/.env, żeby ciasteczko poszło jako
#     SameSite=None; Secure
#   - DISCORD_REDIRECT_URI wskazujący na backend, a adres Pages dodany
#     w panelu aplikacji Discorda
#
# Bez końcowego ukośnika.
VITE_API_URL=https://api.twoja-domena.pl
