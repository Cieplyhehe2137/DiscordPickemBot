# Najnizszy poziom logow, ktory gdziekolwiek trafia. Domyslnie info.
# Ustaw na debug, zeby zobaczyc komunikaty w rodzaju "ten turniej nie ma
# fazy Play-In" - normalnie sa pomijane, zeby nie zagluszaly ostrzezen.
LOG_LEVEL=

# Klucz do LPDB API Liquipedii - zrodlo nazw map po veto.
# Przyznawany na wniosek (liquipedia.net/api). Darmowy dostep jest
# zastrzezony dla niekomercyjnych serwisow spolecznosciowych.
# Czyta go wylacznie scripts/fetchMatchMaps.mjs.
# Limit: 60 zapytan na godzine. Dane na CC-BY-SA 3.0 - atrybucja
# pokazuje sie na stronie meczu.
LIQUIPEDIA_API_KEY=
