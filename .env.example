DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
EXPORT_PANEL_CHANNEL_ID=
LOG_CHANNEL_ID=
ARCHIVE_CHANNEL_ID=
ADMIN_PIN=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
NODE_ENV=

# Id konta Discorda wlasciciela bota. Wchodzi do panelu WWW kazdego
# OBSLUGIWANEGO serwera (czyli takiego, ktory ma swoj plik w config/) bez
# nadanego tam uprawnienia Administrator.
#
# PUSTE = WYJATKU NIE MA i tak jest domyslnie. Discord nie daje wlascicielowi
# aplikacji zadnych uprawnien w gildiach, wiec bez tego wpisu trzeba miec
# Administratora osobno na kazdym serwerze.
#
# Co ten jeden wpis otwiera: wszystkie trasy zapisujace panelu na kazdym
# obslugiwanym serwerze, wlacznie z czyszczeniem fazy i pelnym resetem.
# NIE obejmuje tras, ktorymi gracz zapisuje wlasne typy - tam nadal trzeba
# byc czlonkiem serwera. Szczegoly: server/lib/permissions.js, blok
# "WLASCICIEL BOTA".
BOT_OWNER_ID=

# Najnizszy poziom logow, ktory gdziekolwiek trafia. Domyslnie info.
# Ustaw na debug, zeby zobaczyc komunikaty w rodzaju "ten turniej nie ma
# fazy Play-In" - normalnie sa pomijane, zeby nie zagluszaly ostrzezen.
LOG_LEVEL=

# Klucz do CitoAPI - zrodlo nazw map po veto i tego, KTO je wypickowal.
# Darmowy plan: 500 zapytan na miesiac, klucz od reki, bez karty:
#   https://citoapi.com/signup/?game=cs2
#
# MUSI STAC WLASNIE TUTAJ, w .env bota. Watcher map czyta go z process.env,
# a bot laduje TYLKO ten plik (ENV_FILE albo .env z katalogu, w ktorym
# wstaje) - nigdy server/.env. Klucz wpisany do samego server/.env dziala
# dla scripts/fetchMatchMaps.mjs, bo skrypt czyta oba pliki, i wyglada na
# ustawiony - ale watcher w bocie go nie zobaczy i nie wystartuje.
# API nie czyta tego klucza w ogole.
#
# Jedna synchronizacja turnieju to JEDNO zapytanie - mapy przychodza
# w liscie meczow eventu. Ich regulamin wymaga atrybucji, wiec napis
# pokazuje sie przy mapach na stronie meczu.
CITO_API_KEY=

# Watcher map w bocie: jak czesto sprawdzac i ile zapytan wolno na dobe.
# Puste = wartosci domyslne, czyli co 1800 s (30 min) i 16 zapytan dziennie.
# 16 x 31 dni = 496, czyli ponizej darmowego limitu 500 na miesiac.
# Odstep ma podloge 300 s - literowka nie przepali budzetu.
MAP_SYNC_INTERVAL_SEC=
MAP_SYNC_MAX_PER_DAY=

# Ile sekund PRZED startem meczu zamyka sie typowanie.
#
# Puste = 300 s, czyli piec minut, i tyle samo liczy API. Ta zmienna stala
# dotad TYLKO w server/.env, wiec strona zamykala typowanie piec minut przed
# startem, a bot dokladnie o starcie - dwie rozne godziny dla jednego meczu.
# Teraz obie strony maja te sama wartosc domyslna w kodzie
# (utils/matchLock.js), wiec mozesz to pole zostawic puste.
#
# Jesli je ustawiasz, USTAW TAK SAMO w server/.env - inaczej rozjazd wroci.
# 0 znaczy "zamykaj dokladnie o godzinie startu".
MATCH_LOCK_BEFORE_SEC=
